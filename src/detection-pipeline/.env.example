# Telemetry Services Endpoints
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:8080/jaeger/ui/api/v3/traces
# Leave blank to discover the host mapping using docker port opensearch 9200.
OPENSEARCH_URL=
ACTION_API_URL=http://127.0.0.1:8020
ACTION_AGENT_TOKEN=
ACTION_DRY_RUN=true

# LLM Configuration
# Set to Gemini: gemini/gemini-2.0-flash or gemini/gemini-1.5-pro
LLM_MODEL=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

